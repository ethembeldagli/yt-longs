{
  "manifest_version": 3,
  "name": "YT Longs",
  "version": "1.0.1",
  "description": "Scroll through regular YouTube videos one at a time, just like Shorts.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "YT Longs: scroll videos like Shorts",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "scripts": [
      "src/background.js"
    ]
  },
  "permissions": [
    "storage",
    "scripting",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "exclude_matches": [
        "https://www.youtube.com/embed/*"
      ],
      "js": [
        "src/bridge.js"
      ],
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "exclude_matches": [
        "https://www.youtube.com/embed/*"
      ],
      "js": [
        "src/content.js"
      ]
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "longs_urls",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/overlay.css"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Open or close YT Longs"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "yt-longs@ethembeldagli.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
